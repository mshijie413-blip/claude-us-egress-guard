{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "local-http",
      "listen": "127.0.0.1",
      "port": 17891,
      "protocol": "http",
      "settings": {}
    },
    {
      "tag": "local-socks",
      "listen": "127.0.0.1",
      "port": 17892,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "us-vps",
      "protocol": "vless",
      "settings": {
        "address": "vps.example.com",
        "port": 8443,
        "id": "REPLACE_WITH_VLESS_UUID",
        "encryption": "none",
        "flow": "xtls-rprx-vision"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "serverName": "REPLACE_WITH_TLS_SERVER_NAME",
          "publicKey": "REPLACE_WITH_REALITY_PUBLIC_KEY",
          "shortId": "REPLACE_WITH_REALITY_SHORT_ID",
          "spiderX": "/"
        },
        "sockopt": {
          "interface": "en0"
        }
      }
    }
  ]
}
